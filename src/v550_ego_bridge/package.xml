<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>v550_ego_bridge</name>
  <version>0.1.0</version>
  <description>State and perception adapters between V550_mec and Ego Planner 2D.</description>
  <maintainer email="xwj18737803343@163.com">xzdaring</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <!-- RViz Nav2 Goal 使用 NavigateToPose action，而不是普通目标话题。 -->
  <depend>nav2_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <!-- LaserScan 输入和 PointCloud2 输出都由 sensor_msgs 定义。 -->
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>ego_planner</exec_depend>
  <exec_depend>v550_navigation</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

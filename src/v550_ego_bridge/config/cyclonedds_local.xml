<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <Discovery>
      <!--
        ROS_LOCALHOST_ONLY=1 时，CycloneDDS 在 lo 上使用 participant index
        分配单播发现端口。V550 仿真会同时启动 Gazebo、SLAM、RViz、TF 和多个
        适配节点，默认搜索范围不够，因此允许自动搜索 0~50。
      -->
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>50</MaxAutoParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>

    <parent link="base_link"/>
    <child link="rf_wheel_link"/>
    <axis xyz="0 -1 0"/>
  </joint>
  <link name="camera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-4.45004837215657E-08 -3.25846249904076E-07 -0.0139995077279642"/>
      <mass value="0.0285970249307156"/>
      <inertia ixx="2.49063659552752E-05" ixy="1.41446622396731E-09" ixz="-3.44746104888009E-07" iyy="8.10339394659798E-06" iyz="8.7411817335606E-09" izz="1.91138588188251E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/V550_mec_robot_meshes/camera_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/V550_mec_robot_meshes/camera_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.00160091195407919 -0.00010055304834393 0.152137"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
    <axis xyz="0 0 0"/>
  </joint>
  <link name="laser">
    <inertial>
      <origin rpy="0 0 0" xyz="0.000735465990626988 2.79287293896135E-07 -0.00549379656778799"/>
      <mass value="0.000111381912632097"/>
      <inertia ixx="8.09810255937586E-10" ixy="2.48436925682356E-14" ixz="-2.38955091202816E-14" iyy="8.09668177063905E-10" iyz="-2.28917457095815E-15" izz="1.17057115150887E-10"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/V550_mec_robot_meshes/laser.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.376470588235294 0.376470588235294 0.376470588235294 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/V550_mec_robot_meshes/laser.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="laser_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0834767944381037 1.32296970929568E-05 0.09655"/>
    <!-- 源文件是0 0 -3.1415926 将雷达坐标系绕Z轴旋转了180度-->
    <parent link="base_link"/>
    <child link="laser"/>
    <axis xyz="0 0 0"/>
  </joint>
  <link name="controller_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0254318317483443 0.0178325189887231 0.0120915107345509"/>
      <mass value="0.0371650711916722"/>
      <inertia ixx="2.75273128086897E-05" ixy="-4.90416948087793E-07" ixz="-8.95619686706703E-08" iyy="1.08853888864562E-05" iyz="3.79055088929114E-07" izz="3.7257082402319E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/V550_mec_robot_meshes/controller_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/V550_mec_robot_meshes/controller_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="controller_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.0539080491826598 -0.011432266551253 0.1135"/>
    <parent link="base_link"/>
    <child link="controller_link"/>
    <axis xyz="0 0 0"/>
  </joint>
  <!--
    麦轮平面运动插件。
    它把整个模型视为理想全向底盘，不单独控制四个轮子的 joint。
    因此无法模拟麦轮滚子接触和打滑，但适合先验证 Nav2。
  -->
  <gazebo>
    <plugin filename="libgazebo_ros_planar_move.so" name="v550_planar_move">
      <ros>
        <!-- 接收 Nav2 输出的速度指令 -->
        <remapping>cmd_vel:=cmd_vel</remapping>
        <!--
          插件默认发布 odom。
          为了让仿真和实车使用同一话题名，将其改成 odom_combined。
        -->
        <remapping>odom:=odom_combined</remapping>
      </ros>
      <!-- 插件内部运动更新频率 -->
      <update_rate>100</update_rate>
      <!-- 里程计发布频率 -->
      <publish_rate>30</publish_rate>
      <!-- 发布 nav_msgs/Odometry 话题 -->
      <publish_odom>true</publish_odom>
      <!-- 发布 odom_combined -> base_footprint TF -->
      <publish_odom_tf>true</publish_odom_tf>
      <!-- 与实车 odom_frame_id 保持一致 -->
      <odometry_frame>odom_combined</odometry_frame>
      <!-- 与实车 EKF 输出的 base_link_frame 保持一致 -->
      <robot_base_frame>base_footprint</robot_base_frame>
      <!-- 里程计协方差，仿真中可以先使用较小值 -->
      <covariance_x>0.001</covariance_x>
      <covariance_y>0.001</covariance_y>
      <covariance_yaw>0.005</covariance_yaw>
    </plugin>
  </gazebo>
  <!--
    planar_move 直接设置模型速度。
    仿真中关闭底盘和麦轮的地面摩擦，避免物理接触抵消角速度。
    这里模拟的是理想全向底盘，不模拟轮胎打滑。
  -->
  <gazebo reference="base_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="lf_wheel_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="rf_wheel_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="lb_wheel_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="rb_wheel_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <gravity>false</gravity>
  </gazebo>
  <!--
    在 URDF 的 laser link 上增加 Gazebo 2D 射线传感器。
    Gazebo 根据 reference="laser" 找到已有 laser 坐标系。
  -->
  <gazebo reference="laser">
    <sensor name="v550_lidar" type="ray">
      <!-- 传感器保持工作 -->
      <always_on>true</always_on>
      <!-- 在 Gazebo 中显示激光射线 -->
      <visualize>true</visualize>
      <!-- 10 Hz，与常见 2D 雷达相近 -->
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <!--
                    仿真 M10_P 的近似视场角。
                    实车后方有遮挡，雷达只能看到前方约 200°，
                    因此不能再使用完整的 -π 到 +π。
                -->
            <!-- 200°视场角，建议使用固定点数 -->
            <samples>800</samples>
            <resolution>1.0</resolution>
            <!-- 前方左侧 100°，约 -1.74533 rad -->
            <min_angle>-1.7453292519943295</min_angle>
            <!-- 前方右侧 100°，约 +1.74533 rad -->
            <max_angle>1.7453292519943295</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- 过滤 0.25 m 以内的机器人自身回波，避免起点被代价地图标记为障碍 -->
          <min>0.25</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <!-- ROS 2 LaserScan 发布插件 -->
      <plugin filename="libgazebo_ros_ray_sensor.so" name="v550_lidar_controller">
        <ros>
          <!-- 插件默认输出 ~/out，重映射成 /scan -->
          <remapping>~/out:=scan</remapping>
        </ros>
        <!-- 输出 sensor_msgs/LaserScan -->
        <output_type>sensor_msgs/LaserScan</output_type>
        <!-- LaserScan.header.frame_id = laser -->
        <frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
